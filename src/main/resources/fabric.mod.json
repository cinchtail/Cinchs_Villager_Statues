{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=0.21.0"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_discord}",
        "modmenu.curseforge": "${mod_curseforge}",
        "modmenu.modrinth": "${mod_modrinth}",
        "modmenu.kofi": "${mod_kofi}",
        "modmenu.youtube": "${mod_youtube}"
      },
      "update_checker": true
    }
  }
}